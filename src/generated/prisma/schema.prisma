generator client {
  provider        = "prisma-client-js"
  output          = ""
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model task {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at       DateTime        @default(now()) @db.Timestamptz(6)
  description      String?         @default("")
  completed        Boolean         @default(false)
  completed_at     DateTime?       @db.Date
  title            String?
  priority_level   Int             @default(0) @db.SmallInt
  due_date         DateTime?       @db.Timestamptz(6)
  task_category_id String          @db.Uuid
  repeating_type   DateRepeatType?
  expense_id       String?         @db.Uuid
  is_archived      Boolean         @default(false)
  expense          expense?        @relation(fields: [expense_id], references: [id], onDelete: Cascade)
  task_category    task_category   @relation(fields: [task_category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model task_category {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  title      String   @default("")
  user_id    String   @db.Uuid
  task       task[]

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model bill_expense {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  expense_id     String          @unique @db.Uuid
  repeating_type DateRepeatType?
  running_bill   Int?            @db.SmallInt
  expense        expense         @relation(fields: [expense_id], references: [id], onDelete: Cascade)

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model expense {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at             DateTime                @default(now()) @db.Timestamptz(6)
  name                   String?
  description            String?
  expense_type           ExpenseType?
  user_id                String?                 @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  is_archived            Boolean                 @default(false)
  bill_expense           bill_expense?
  stock                  stock?
  task                   task[]
  transaction            transaction[]
  transportation_expense transportation_expense?

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model stock {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  curr_amount Int?     @db.SmallInt
  min_amount  Int      @db.SmallInt
  expense_id  String   @unique @db.Uuid
  expense     expense  @relation(fields: [expense_id], references: [id], onDelete: Cascade)

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model transaction {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at    DateTime          @default(now()) @db.Timestamptz(6)
  expense_id    String            @db.Uuid
  amount        Int               @default(1)
  price         Float             @default(0)
  status        TransactionStatus @default(PENDING)
  repeat_at     DateTime?         @db.Timestamptz(6)
  date_transact DateTime          @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamptz(6)
  expense       expense           @relation(fields: [expense_id], references: [id], onDelete: Cascade)

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model transportation_expense {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  expense_id String   @unique @db.Uuid
  cost_list  Int[]    @db.SmallInt
  expense    expense  @relation(fields: [expense_id], references: [id], onDelete: Cascade)

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model income {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  amount        Float?    @db.Real
  user_id       String?   @db.Uuid
  from_job      Boolean   @default(false)
  date_obtained DateTime? @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamptz(6)

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model budget {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  user_id    String?  @db.Uuid

  @@schema("public")
}

enum DateRepeatType {
  YEARLY
  MONTHLY
  DAILY
  MANUAL
  BIWEEKLY
  WEEKLY

  @@schema("public")
}

enum TransactionStatus {
  PAID
  CANCELLED
  PENDING

  @@schema("public")
}

enum ExpenseType {
  HOUSE
  PERSONAL
  TRANSPORTATION
  GROCERY
  MISC

  @@schema("public")
}
